# ==============================================================================
# CONFIGURACIÓN GENERAL DEL SISTEMA Y BASE DE DATOS
# Copia este archivo a `.env` y asigna tus credenciales locales o de producción.
# ==============================================================================

# --- Seguridad JWT ---
# Clave secreta para firma de tokens JWT (HS256: mínimo 256 bits / 32 bytes)
JWT_SECRET=tu_clave_secreta_jwt_muy_segura_de_al_menos_256_bits_aqui
JWT_EXPIRATION=3600000

# --- PostgreSQL Superusuario / Podman Compose ---
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_pass
POSTGRES_DB=postgres

# --- Auth Service ---
SERVER_PORT_AUTH=8081
DB_AUTH_URL=jdbc:postgresql://localhost:5432/authdb
DB_AUTH_USERNAME=auth_user
DB_AUTH_PASSWORD=auth_pass

# --- Table Service ---
SERVER_PORT_TABLE=8082
DB_TABLE_URL=jdbc:postgresql://localhost:5432/tabledb
DB_TABLE_USERNAME=table_user
DB_TABLE_PASSWORD=table_pass

# --- Menu Service ---
SERVER_PORT_MENU=8083
DB_MENU_URL=jdbc:postgresql://localhost:5432/menudb
DB_MENU_USERNAME=menu_user
DB_MENU_PASSWORD=menu_pass

# --- Credenciales para Microservicios Futuros ---
DB_ORDER_PASSWORD=order_pass
DB_INVENTORY_PASSWORD=inventory_pass
DB_EMPLOYEE_PASSWORD=employee_pass
DB_KITCHEN_PASSWORD=kitchen_pass
DB_PAYMENT_PASSWORD=payment_pass
DB_DELIVERY_PASSWORD=delivery_pass
DB_REPORT_PASSWORD=report_pass
