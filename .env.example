# ==============================================================================
# CONFIGURACIÓN GENERAL DEL SISTEMA Y BASE DE DATOS
# Copia este archivo a `.env` y asigna tus credenciales locales o de producción.
# ==============================================================================

# --- Seguridad JWT ---
# Clave secreta para firma de tokens JWT (HS256: mínimo 256 bits / 32 bytes)
JWT_SECRET=default_jwt_secret_key_restaurant_system_must_be_overridden_in_prod_at_least_256_bits
JWT_EXPIRATION=3600000

# --- PostgreSQL Superusuario / Podman Compose ---
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_pass
POSTGRES_DB=postgres

# --- 1. Auth Service (Puerto: 8081) ---
SERVER_PORT_AUTH=8081
DB_AUTH_URL=jdbc:postgresql://localhost:5432/authdb
DB_AUTH_USERNAME=auth_user
DB_AUTH_PASSWORD=auth_pass

# --- 2. Table Service (Puerto: 8082) ---
SERVER_PORT_TABLE=8082
DB_TABLE_URL=jdbc:postgresql://localhost:5432/tabledb
DB_TABLE_USERNAME=table_user
DB_TABLE_PASSWORD=table_pass

# --- 3. Menu Service (Puerto: 8083) ---
SERVER_PORT_MENU=8083
DB_MENU_URL=jdbc:postgresql://localhost:5432/menudb
DB_MENU_USERNAME=menu_user
DB_MENU_PASSWORD=menu_pass

# --- 4. Employee Service (Puerto: 8084) ---
SERVER_PORT_EMPLOYEE=8084
DB_EMPLOYEE_URL=jdbc:postgresql://localhost:5432/employeedb
DB_EMPLOYEE_USERNAME=employee_user
DB_EMPLOYEE_PASSWORD=employee_pass

# --- 5. Inventory Service (Puerto: 8085) ---
SERVER_PORT_INVENTORY=8085
DB_INVENTORY_URL=jdbc:postgresql://localhost:5432/inventorydb
DB_INVENTORY_USERNAME=inventory_user
DB_INVENTORY_PASSWORD=inventory_pass

# --- 6. Order Service (Puerto: 8086) ---
SERVER_PORT_ORDER=8086
DB_ORDER_URL=jdbc:postgresql://localhost:5432/orderdb
DB_ORDER_USERNAME=order_user
DB_ORDER_PASSWORD=order_pass

# --- 7. Kitchen Service (Puerto: 8087) ---
SERVER_PORT_KITCHEN=8087
DB_KITCHEN_URL=jdbc:postgresql://localhost:5432/kitchendb
DB_KITCHEN_USERNAME=kitchen_user
DB_KITCHEN_PASSWORD=kitchen_pass

# --- 8. Payment Service (Puerto: 8088) ---
SERVER_PORT_PAYMENT=8088
DB_PAYMENT_URL=jdbc:postgresql://localhost:5432/paymentdb
DB_PAYMENT_USERNAME=payment_user
DB_PAYMENT_PASSWORD=payment_pass

# --- 9. Delivery Service (Puerto: 8089) ---
SERVER_PORT_DELIVERY=8089
DB_DELIVERY_URL=jdbc:postgresql://localhost:5432/deliverydb
DB_DELIVERY_USERNAME=delivery_user
DB_DELIVERY_PASSWORD=delivery_pass
DELIVERY_WEBHOOK_SECRET=restaurant_delivery_default_webhook_secret_key_2026

# --- 10. Report Service (Puerto: 8090) ---
SERVER_PORT_REPORT=8090
DB_REPORT_URL=jdbc:postgresql://localhost:5432/reportdb
DB_REPORT_USERNAME=report_user
DB_REPORT_PASSWORD=report_pass

# --- URLs de Comunicación Entre Microservicios ---
AUTH_SERVICE_URL=http://localhost:8081
TABLE_SERVICE_URL=http://localhost:8082
MENU_SERVICE_URL=http://localhost:8083
EMPLOYEE_SERVICE_URL=http://localhost:8084
INVENTORY_SERVICE_URL=http://localhost:8085
ORDER_SERVICE_URL=http://localhost:8086
KITCHEN_SERVICE_URL=http://localhost:8087
PAYMENT_SERVICE_URL=http://localhost:8088
DELIVERY_SERVICE_URL=http://localhost:8089
REPORT_SERVICE_URL=http://localhost:8090
